# Postgres (Railway production, and local via Docker or a local server)
# Docker: docker compose up -d db
# Then: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/send_unity_circle"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/send_unity_circle"

# Shared password for /admin (required)
ADMIN_PASSWORD="change-me"

# Public site origin. Set this on Railway so Join redirects do not send phones to localhost.
# APP_URL="https://web-production-fdef7.up.railway.app"

# Public label for the account that joins school groups
FOUNDER_WHATSAPP_DISPLAY="SEND Unity Circle admin"

# Optional backup: E.164 number parents can copy. Joining via the invite link is the primary path.
# FOUNDER_WHATSAPP_E164="+447700900000"

# Family tools chat (OpenAI-compatible). If OPENAI_API_KEY is unset, the page stays up with a friendly unavailable state.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"
